# ===== MADO 環境変数 =====
# YouTube Data API v3 (収集パイプラインで使用 / Google Cloud Consoleで取得)
YOUTUBE_API_KEY=your_youtube_data_api_key

# Google Gemini API (回答生成・タグ付けで使用 / https://aistudio.google.com で無料取得)
GEMINI_API_KEY=your_gemini_api_key

# --- 任意: モデル・閾値の差し替え ---
# MADO_GEMINI_MODEL=gemini-2.0-flash
# MADO_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# MADO_SIM_THRESHOLD=0.35
# MADO_CHROMA_DIR=./data/chroma

# タグ付けのリクエスト間隔(秒)。無料枠は既定4.5のまま。
# 課金有効のAPIキーなら 0.5 に下げると全件タグ付けが数十分で完了
# MADO_TAG_INTERVAL=4.5
